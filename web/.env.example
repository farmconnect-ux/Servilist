# Copy to .env.local for local development. Never commit real values.

# Supabase project (database, accounts, storage). The publishable key is safe
# to expose; access is enforced by row-level security in the database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public address of this deployment, used in confirmation and reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments. All of these are server-only secrets: set them in the hosting
# dashboard, never in a file that is committed. Leave a provider's key empty to
# switch that provider off. With no keys set, checkout says payment is not
# available yet. See docs/PAYMENTS_SETUP.md.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you choose in Flutterwave's webhook settings
FLUTTERWAVE_WEBHOOK_HASH=
# A long random value (32+ characters) that lets this server, and nothing else,
# record a payment as confirmed. The database holds only its hash.
PAYMENTS_SERVER_SECRET=

# --- Not used yet; added by the sprint that needs them ---
# Messaging providers
# EMAIL_PROVIDER_KEY=
# SMS_PROVIDER_KEY=
# Maps, cache and error reporting
# MAPS_API_KEY=
# REDIS_URL=
# SENTRY_DSN=
