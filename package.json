{
  "name": "servilist",
  "version": "0.1.0",
  "description": "Pan-African classifieds, live auctions, buyer requests & escrow marketplace",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "marketplace",
    "africa",
    "classifieds",
    "auctions",
    "escrow",
    "rfq"
  ],
  "author": "Servilist Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
